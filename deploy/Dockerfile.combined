# Combined Vellum container: runs CES + assistant daemon + gateway in one machine.
#
# Shared state: single volume mounted at /data. The entrypoint symlinks
# /root/.vellum -> /data/vellum, so all three processes see:
#   /root/.vellum/protected/keys.enc       ← shared encrypted credentials
#   /root/.vellum/protected/store.key      ← v2 store key (32 bytes)
#   /root/.vellum/protected/actor-token-signing-key  ← JWT HMAC key
#   /root/.vellum/workspace/               ← assistant DB, skills, identity
#   /data/vellum/ces-data/                 ← CES grants, audit, toolstore
#
# Build from repo root:
#   flyctl deploy --config deploy/fly/combined.toml \
#                 --dockerfile deploy/Dockerfile.combined --remote-only

ARG BUN_VERSION=bun-v1.3.11

# ─────────────────────────────────────────────────────────────────────
# Stage 1: builder — installs deps and gathers source for all services
# ─────────────────────────────────────────────────────────────────────
FROM debian:trixie-slim@sha256:4ffb3a1511099754cddc70eb1b12e50ffdb67619aa0ab6c13fcd800a78ef7c7a AS builder

WORKDIR /app

# Build toolchain for native deps (tree-sitter, etc.)
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    python3 \
    make \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

ARG BUN_VERSION
RUN curl -fsSL https://bun.sh/install | bash -s "${BUN_VERSION}"
ENV PATH="/root/.bun/bin:${PATH}"

# ----- Shared packages (deps for assistant, gateway, and CES) -----
COPY packages/ces-contracts       ./packages/ces-contracts
COPY packages/credential-storage  ./packages/credential-storage
COPY packages/egress-proxy        ./packages/egress-proxy

# ----- Feature-flag registry (must be present BEFORE any bun install so -----
#       the assistant + gateway postinstall scripts sync it to their
#       bundled-copy paths automatically).
COPY meta ./meta

# ----- Credential Executor Service (CES) -----
COPY credential-executor/package.json credential-executor/bun.lock* ./credential-executor/
RUN cd /app/credential-executor && bun install --frozen-lockfile
COPY credential-executor ./credential-executor

# ----- Assistant: install deps (postinstall syncs feature-flag registry) -----
COPY assistant/package.json assistant/bun.lock ./assistant/
RUN cd /app/assistant && bun install --frozen-lockfile

# Bundled first-party skills (matches assistant/Dockerfile behavior)
COPY skills ./skills
RUN set -eu; for pkg in /app/skills/*/package.json; do \
      [ -e "$pkg" ] || continue; \
      dir="$(dirname "$pkg")"; \
      echo "Installing deps for $dir"; \
      (cd "$dir" && (bun install --frozen-lockfile 2>/dev/null || bun install)); \
    done

COPY assistant ./assistant

# ----- Gateway: install deps (postinstall syncs feature-flag registry too) --
COPY gateway/package.json gateway/bun.lock ./gateway/
RUN cd /app/gateway && bun install --frozen-lockfile --production

COPY gateway ./gateway

# ----- Admin UI (Vite + React + Tailwind SPA served at /admin) --------------
# Install its deps separately so the layer is cached on pure dep bumps, then
# build. The gateway runtime reads from gateway/admin-ui/dist at request time
# (see gateway/src/admin/routes.ts).
RUN cd /app/gateway/admin-ui && bun install --frozen-lockfile
RUN cd /app/gateway/admin-ui && bun run build \
 && test -f /app/gateway/admin-ui/dist/index.html \
 && test -d /app/gateway/admin-ui/dist/assets

# ----- Feature-flag registry: run the sync script deterministically -----
#       The assistant + gateway postinstall scripts SHOULD do this
#       automatically, but the upstream hook suppresses errors with
#       `2>/dev/null || true`, so failures silently leave the bundled
#       copies missing. Running the script explicitly here turns a silent
#       failure into a fail-fast build error.
RUN cd /app && bun run meta/feature-flags/sync-bundled-copies.ts \
 && test -f /app/assistant/src/config/feature-flag-registry.json \
 && test -f /app/gateway/src/feature-flag-registry.json

# ─────────────────────────────────────────────────────────────────────
# Stage 2: runtime — Debian + Bun + assistant system deps + all three apps
# ─────────────────────────────────────────────────────────────────────
FROM debian:trixie-slim@sha256:4ffb3a1511099754cddc70eb1b12e50ffdb67619aa0ab6c13fcd800a78ef7c7a AS runner

WORKDIR /app

# Same system deps as assistant/Dockerfile — Playwright, ffmpeg, etc.
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    bubblewrap \
    ca-certificates \
    curl \
    ffmpeg \
    fonts-freefont-ttf \
    g++ \
    git \
    iproute2 \
    jq \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdrm2 \
    libfreetype6 \
    libgbm1 \
    libharfbuzz0b \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb-dri3-0 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxkbcommon0 \
    libxrandr2 \
    libxrender1 \
    libxshmfence1 \
    libxtst6 \
    lsof \
    openssl \
    procps \
    python3 \
    sqlite3 \
    tini \
    unzip \
    uuid-runtime \
    xclip \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Bun from builder (both bun and bunx)
COPY --from=builder /root/.bun/bin/bun /usr/local/bin/bun
RUN ln -sf /usr/local/bin/bun /usr/local/bin/bunx

# Application trees (assistant, gateway, CES, packages, skills, meta, deploy)
COPY --from=builder /app /app
COPY deploy ./deploy

# Ensure assistant's legacy entrypoint is executable (we don't use it — our
# combined entrypoint supersedes it — but keep the bit set so any debugging
# invocation works).
RUN chmod +x /app/assistant/docker-entrypoint.sh

# Our orchestrating entrypoint (starts CES → assistant → gateway)
COPY deploy/entrypoint-combined.sh /usr/local/bin/entrypoint-combined.sh
RUN chmod +x /usr/local/bin/entrypoint-combined.sh

# ─────────────────────────────────────────────────────────────────────
# Runtime env — all three processes resolve credentials against the same
# shared directory on the mounted volume.
# ─────────────────────────────────────────────────────────────────────
ENV IS_CONTAINERIZED=true
ENV HOME=/root
ENV VELLUM_WORKSPACE_DIR=/root/.vellum/workspace

# ---- Credential Executor Service (managed sidecar mode) ----
# CES owns writes to keys.enc/store.key; assistant reads via CES-RPC over the
# bootstrap socket; gateway reads keys.enc directly from the shared dir.
ENV CES_MODE=managed
ENV CES_HEALTH_PORT=8090
ENV CES_DATA_ROOT=/data/vellum/ces-data
ENV CES_BOOTSTRAP_SOCKET_DIR=/run/ces-bootstrap
ENV CREDENTIAL_SECURITY_DIR=/root/.vellum/protected

# ---- Gateway ----
ENV GATEWAY_PORT=7830
ENV ASSISTANT_HOST=127.0.0.1
ENV GATEWAY_SECURITY_DIR=/root/.vellum/protected
ENV RUNTIME_PROXY_ENABLED=true
ENV RUNTIME_PROXY_REQUIRE_AUTH=true

# ---- Assistant daemon ----
ENV RUNTIME_HTTP_PORT=3001
ENV RUNTIME_HTTP_HOST=127.0.0.1

# Only the gateway is publicly exposed.
EXPOSE 7830

# tini as init — forwards signals, reaps zombies for bash children.
ENTRYPOINT ["/usr/bin/tini", "-s", "--"]
CMD ["/usr/local/bin/entrypoint-combined.sh"]
